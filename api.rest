# ==============================================================================
# WARENGINE API - Master Test Suite
# Requiere: REST Client (extensión VS Code)
# Servidor: http://localhost:8017  (deno task dev-api)
#
# ARCHIVOS DE PRUEBA POR MÓDULO:
#   http/01-autenticacion.http  — Login, renovar token, logout, verificar
#   http/02-sucursales.http     — CRUD de sucursales (RF-ADM-C1, C2, C3)
#   http/03-usuarios.http       — Gestión de usuarios (RF-ADM-C5, C6, C7, C8)
#   http/04-inventario.http     — Gestión de categorías y proveedores (RF-ADM-B5, B6)
#
# ESTADO DE ENDPOINTS (probado 2026-10-06):
#   ✅ POST   /auth/login
#   ✅ POST   /auth/renovar-token
#   ✅ GET    /auth/verificar
#   ✅ POST   /auth/logout
#   ✅ GET    /health
#   ✅ GET    /administracion/sucursales
#   ✅ POST   /administracion/sucursales
#   ✅ PUT    /administracion/sucursales/:id
#   ✅ GET    /administracion/usuarios
#   ✅ GET    /administracion/usuarios?rolId=&sucursalId=
#   ✅ POST   /administracion/usuarios
#   ✅ PUT    /administracion/usuarios/:id/rol
#   ✅ PUT    /administracion/usuarios/:id/estado
#   ✅ GET    /inventario/categorias
#   ✅ GET    /inventario/categorias/:id
#   ✅ POST   /inventario/categorias
#   ✅ PUT    /inventario/categorias/:id
#   ✅ PUT    /inventario/categorias/:id/estado
#   ✅ GET    /inventario/proveedores
#   ✅ GET    /inventario/proveedores/:id
#   ✅ POST   /inventario/proveedores
#   ✅ PUT    /inventario/proveedores/:id
#   ✅ PUT    /inventario/proveedores/:id/estado
# ==============================================================================

@baseUrl = http://localhost:8017

# ==============================================================================
# INICIO RÁPIDO — Login + pruebas básicas en un solo archivo
# Para pruebas completas, abre los archivos en http/
# ==============================================================================

### 1. Login Superadmin
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "superadmin@warengine.local",
  "password": "Warengine.Admin.2026!"
}

###

### 2. Renovar Token
POST {{baseUrl}}/auth/renovar-token
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.refreshToken}}"
}

###

### 3. Verificar Sesión
GET {{baseUrl}}/auth/verificar
Authorization: Bearer {{login.response.body.accessToken}}

###

### 4. Cerrar Sesión
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{login.response.body.accessToken}}

###

### 5. Health Check
GET {{baseUrl}}/health

###

# ==============================================================================
# MÓDULO ADMINISTRACIÓN - SUCURSALES
# ==============================================================================

### 6. Listar Sucursales (RF-ADM-C1)
GET {{baseUrl}}/administracion/sucursales
Authorization: Bearer {{login.response.body.accessToken}}

###

### 7. Crear Sucursal (RF-ADM-C2)
# @name crearSucursal
POST {{baseUrl}}/administracion/sucursales
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "nombre": "Sucursal Norte",
  "direccion": "Calle 170 # 15-20, Bogotá",
  "contacto": "+57 300 1234567"
}

###

### 8. Editar Sucursal (RF-ADM-C3)
PUT {{baseUrl}}/administracion/sucursales/{{crearSucursal.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "nombre": "Sucursal Principal Central",
  "direccion": "Cra 7 # 72-10, Bogotá",
  "contacto": "admin@warengine.local",
  "isActive": true
}

###

# ==============================================================================
# MÓDULO ADMINISTRACIÓN - USUARIOS
# ==============================================================================

### 9. Listar Usuarios (RF-ADM-C5)
GET {{baseUrl}}/administracion/usuarios
Authorization: Bearer {{login.response.body.accessToken}}

###

### 10. Listar Usuarios con Filtro por Rol (RF-ADM-C5)
GET {{baseUrl}}/administracion/usuarios?rolId=2&sucursalId=1
Authorization: Bearer {{login.response.body.accessToken}}

###

### 11. Crear Usuario + Empleado Atómico (RF-ADM-C6)
# @name crearUsuario
POST {{baseUrl}}/administracion/usuarios
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "nombre": "Juan Pérez",
  "tipoDocumento": "CC",
  "numeroDocumento": "1020304050",
  "email": "juan.perez@warengine.local",
  "password": "Password.2026!",
  "rolId": 2,
  "sucursalId": 1,
  "cargo": "Administrador de Sucursal"
}

###

### 12. Cambiar Rol de Usuario (RF-ADM-C7)
PUT {{baseUrl}}/administracion/usuarios/{{crearUsuario.response.body.id}}/rol
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "rolId": 3
}

###

### 13. Cambiar Estado de Usuario - Desactivar (RF-ADM-C8)
PUT {{baseUrl}}/administracion/usuarios/{{crearUsuario.response.body.id}}/estado
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "isActive": false
}

###

### 14. Cambiar Estado de Usuario - Reactivar (RF-ADM-C8)
PUT {{baseUrl}}/administracion/usuarios/{{crearUsuario.response.body.id}}/estado
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "isActive": true
}

###

### 15. Regla de Negocio: Intentar desactivar Super Admin (debe retornar 400)
PUT {{baseUrl}}/administracion/usuarios/{{login.response.body.usuario.id}}/estado
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "isActive": false
}

###

# ==============================================================================
# MÓDULO INVENTARIO - CATEGORÍAS DE PRODUCTO (RF-ADM-B5)
# ==============================================================================

### 16. Listar Categorías con paginación, búsqueda y filtro de estado (RF-ADM-B5)
# Esperado: 200 OK con { items: [...], total, page, limit, totalPages }
GET {{baseUrl}}/inventario/categorias?busqueda=Bebidas&isActive=true&page=1&limit=10
Authorization: Bearer {{login.response.body.accessToken}}

###

### 17. Crear Categoría (RF-ADM-B5)
# Esperado: 201 Created con { id, nombre, isActive: true }
# @name crearCategoria
POST {{baseUrl}}/inventario/categorias
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "nombre": "Bebidas Azucaradas y Refrescos"
}

###

### 18. Obtener Categoría por ID (RF-ADM-B5)
# Esperado: 200 OK con { id, nombre, isActive }
GET {{baseUrl}}/inventario/categorias/{{crearCategoria.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}

###

### 19. Editar Categoría (RF-ADM-B5)
# Esperado: 200 OK con la categoría modificada
PUT {{baseUrl}}/inventario/categorias/{{crearCategoria.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "nombre": "Bebidas y Refrescos Embotellados"
}

###

### 20. Inactivar Categoría (RF-ADM-B5)
# Esperado: 200 OK con { id, nombre, isActive: false }
PUT {{baseUrl}}/inventario/categorias/{{crearCategoria.response.body.id}}/estado
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "isActive": false
}

###

### 21. Reactivar Categoría (RF-ADM-B5)
# Esperado: 200 OK con { id, nombre, isActive: true }
PUT {{baseUrl}}/inventario/categorias/{{crearCategoria.response.body.id}}/estado
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "isActive": true
}

###

# ==============================================================================
# MÓDULO INVENTARIO - PROVEEDORES (RF-ADM-B6)
# ==============================================================================

### 22. Listar Proveedores con paginación, búsqueda y filtro de estado (RF-ADM-B6)
# Esperado: 200 OK con { items: [...], total, page, limit, totalPages }
GET {{baseUrl}}/inventario/proveedores?busqueda=Lácteos&isActive=true&page=1&limit=10
Authorization: Bearer {{login.response.body.accessToken}}

###

### 23. Crear Proveedor (RF-ADM-B6)
# Esperado: 201 Created con { id, nombre, contacto, isActive: true }
# @name crearProveedor
POST {{baseUrl}}/inventario/proveedores
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "nombre": "Distribuidora Lácteos del Campo S.A.S.",
  "contacto": "ventas@lacteosdelcampo.com / +57 310 9876543"
}

###

### 24. Obtener Proveedor por ID (RF-ADM-B6)
# Esperado: 200 OK con { id, nombre, contacto, isActive }
GET {{baseUrl}}/inventario/proveedores/{{crearProveedor.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}

###

### 25. Editar Proveedor (RF-ADM-B6)
# Esperado: 200 OK con el proveedor modificado
PUT {{baseUrl}}/inventario/proveedores/{{crearProveedor.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "nombre": "Distribuidora Lácteos del Campo Colombia",
  "contacto": "pedidos@lacteosdelcampo.com"
}

###

### 26. Inactivar Proveedor (RF-ADM-B6)
# Esperado: 200 OK con { id, nombre, contacto, isActive: false }
PUT {{baseUrl}}/inventario/proveedores/{{crearProveedor.response.body.id}}/estado
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "isActive": false
}

###

### 27. Reactivar Proveedor (RF-ADM-B6)
# Esperado: 200 OK con { id, nombre, contacto, isActive: true }
PUT {{baseUrl}}/inventario/proveedores/{{crearProveedor.response.body.id}}/estado
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "isActive": true
}

###

# ==============================================================================
# CASOS DE ERROR LISTOS PARA EJECUTAR (VALIDACIONES Y PERMISOS)
# ==============================================================================

### 28. Error: Crear Categoría con cuerpo inválido (nombre vacío - Validación Zod)
# Esperado: 400 Bad Request con { error: "VALIDATION_ERROR", issues: [...] }
POST {{baseUrl}}/inventario/categorias
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "nombre": ""
}

###

### 29. Error: Obtener Categoría con ID inexistente
# Esperado: 404 Not Found con { error: "CATEGORIA_NO_ENCONTRADA", message: "La categoría no existe." }
GET {{baseUrl}}/inventario/categorias/999999
Authorization: Bearer {{login.response.body.accessToken}}

###

### 30. Error: Crear Proveedor con cuerpo inválido (nombre vacío - Validación Zod)
# Esperado: 400 Bad Request con { error: "VALIDATION_ERROR", issues: [...] }
POST {{baseUrl}}/inventario/proveedores
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "nombre": ""
}

###

### 31. Error: Obtener Proveedor con ID inexistente
# Esperado: 404 Not Found con { error: "PROVEEDOR_NO_ENCONTRADO", message: "El proveedor no existe." }
GET {{baseUrl}}/inventario/proveedores/999999
Authorization: Bearer {{login.response.body.accessToken}}

###

### 32. Error: Petición sin autenticación (Falta cabecera Authorization)
# Esperado: 401 Unauthorized con { error: "UNAUTHORIZED", message: "Falta token de autorización" }
GET {{baseUrl}}/inventario/categorias

###

