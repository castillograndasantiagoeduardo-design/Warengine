# ============================================================
# WARENGINE — Variables de entorno de ejemplo
# Copia este archivo como .env y completa con valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# ─── Base de datos (MySQL) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=warengine
DB_USER=warengine_user
DB_PASSWORD=admin123
DB_ROOT_PASSWORD=cambia_esta_contrasena_root

# ─── Entorno ──────────────────────────────────────────────────
# Entorno de ejecución: 'development' | 'production' | 'test'.
# En 'development', las cookies de sesión se marcan sin el flag Secure (HTTP local)
# y se permite la inicialización de super-admin mediante seed.
# En cualquier otro entorno, Secure=true es forzado automáticamente.
NODE_ENV=development

# Contraseña del primer super-admin (solo usada por `deno task seed:dev`)
SEED_SUPERADMIN_PASSWORD=Warengine.Admin.2026!

# ─── JWT (Autenticación) ─────────────────────────────────────
# Secreto criptográfico obligatorio para firma de tokens HMAC-SHA256 (MÍNIMO 32 caracteres).
# Si la variable no existe o tiene menos de 32 caracteres, la API se negará a arrancar.
# Generar una clave segura con: openssl rand -base64 32  o  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_jwt_key_warengine_2026_min_32_characters_long_for_security!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
# Lista de orígenes permitidos separados por comas.
# Si la cabecera Origin de la petición no coincide con ninguno, no se devuelven cabeceras CORS.
CORS_ORIGENES=http://localhost:3000

# ─── Bloqueo por Intentos Fallidos (RF-SA-F1, F2, F3) ─────────
# Variables opcionales para configurar la política de bloqueo de login.
# Deben ser enteros positivos si se configuran; de lo contrario el arranque fallará.
# Valores por defecto comentados:
# LOGIN_MAX_INTENTOS_CUENTA=5
# LOGIN_VENTANA_CUENTA_MIN=5
# LOGIN_MAX_INTENTOS_IP=20
# LOGIN_VENTANA_IP_MIN=15

# ─── API REST ─────────────────────────────────────────────────
API_PORT=8017
API_HOST=0.0.0.0

# ─── Servidor MCP ─────────────────────────────────────────────
MCP_PORT=3002

# ─── Correo (recuperación de contraseña) ──────────────────────
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=noreply@warengine.com
SMTP_PASSWORD=contrasena_smtp
SMTP_FROM="Warengine <noreply@warengine.com>"

# ─── Frontend (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8017
