# ============================================================
# WARENGINE — Variables de entorno (ejemplo para desarrollo/producción)
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio de código.
# ============================================================

# ─── Base de datos (MySQL) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=warengine
DB_USER=warengine_user
DB_PASSWORD=admin123
DB_ROOT_PASSWORD=cambia_esta_contrasena_root

# ─── Entorno ──────────────────────────────────────────────────
# 'development' habilita el seed del superadmin y cookies sin TLS.
# Cualquier otro valor (o si no se define) activa secure=true en cookies.
NODE_ENV=development

# Contraseña del primer super-admin (solo usada por `deno task seed:dev`, mín. 12 caracteres)
SEED_SUPERADMIN_PASSWORD=Warengine.Admin.2026!

# ─── JWT (JSON Web Tokens) ───────────────────────────────────
# OBLIGATORIO: Mínimo 32 caracteres criptográficos aleatorios.
# Puedes generarlo con: openssl rand -hex 32
JWT_SECRET=4f7b2c9e1a8d3f605b4a7c2e9d1f8a3b5c7e9f1a2d4b6c8e0a1f3d5b7c9e2a4f
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
# Lista de orígenes permitidos separados por comas para cabeceras CORS con credentials
CORS_ORIGENES=http://localhost:3000

# ─── Bloqueo por Intentos Fallidos (Rate Limiting de Login) ──
# Variables opcionales. Si se definen, deben ser enteros positivos > 0.
# Valores por defecto del sistema:
# LOGIN_MAX_INTENTOS_CUENTA=5
# LOGIN_VENTANA_CUENTA_MIN=5
# LOGIN_MAX_INTENTOS_IP=20
# LOGIN_VENTANA_IP_MIN=15

# ─── API REST ─────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0

# ─── Servidor MCP ─────────────────────────────────────────────
MCP_PORT=3002

# ─── Correo (recuperación de contraseña) ──────────────────────
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=noreply@warengine.com
SMTP_PASSWORD=contrasena_smtp
SMTP_FROM="Warengine <noreply@warengine.com>"

# ─── Frontend (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
