# ============================================================
# WARENGINE — Variables de entorno (copia este archivo como .env
# y rellena los valores reales. NUNCA subas .env al repositorio)
# ============================================================

# ─── Base de datos (MySQL) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=warengine
DB_USER=warengine_user
DB_PASSWORD=cambia_esta_contrasena
DB_ROOT_PASSWORD=cambia_esta_contrasena_root

# ─── JWT ─────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios
JWT_SECRET=genera_un_secreto_de_al_menos_32_caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── API REST ─────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0

# ─── Servidor MCP ─────────────────────────────────────────────
MCP_PORT=3002

# ─── Correo (recuperación de contraseña) ──────────────────────
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=noreply@warengine.com
SMTP_PASSWORD=contrasena_smtp
SMTP_FROM="Warengine <noreply@warengine.com>"

# ─── Frontend (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
