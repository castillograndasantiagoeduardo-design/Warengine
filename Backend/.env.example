# ==============================================================================
# Warengine API — variables de entorno (plantilla SIN valores reales)
# Copia este archivo a `.env` y completa los valores. `.env` está ignorado por git.
# Las tareas de deno.json cargan `.env` con la bandera --env.
# ==============================================================================

# ─── Base de datos MySQL 8 ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=warengine_user
DB_PASSWORD=
DB_NAME=warengine

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Secreto HS256 para firmar los JWT (cadena larga y aleatoria).
JWT_SECRET=
# Orígenes permitidos por CORS, separados por comas (ej. http://localhost:3000).
CORS_ORIGENES=http://localhost:3000
# URL pública del frontend (enlaces de recuperación de contraseña).
FRONTEND_URL=http://localhost:3000
# Política de bloqueo por fuerza bruta (opcionales; el backend tiene valores por defecto).
LOGIN_MAX_INTENTOS_CUENTA=
LOGIN_VENTANA_CUENTA_MIN=
LOGIN_MAX_INTENTOS_IP=
LOGIN_VENTANA_IP_MIN=

# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Seeds (solo desarrollo) ──────────────────────────────────────────────────
# Contraseña del super-admin inicial (deno task seed:dev). Mínimo 12 caracteres.
SEED_SUPERADMIN_PASSWORD=
# Contraseña común de los usuarios de prueba de la demo (deno task seed:demo):
# admin.norte, cajero1, cajero2 y vendedor.b2b @warengine.local. Mínimo 12 caracteres.
SEED_DEMO_PASSWORD=

# ─── Pruebas manuales (.http / scripts) ───────────────────────────────────────
# Contraseña del super-admin usada al probar contra la API real. Debe coincidir con
# SEED_SUPERADMIN_PASSWORD. Los .http la leen con {{$processEnv WARENGINE_SA_PASSWORD}}.
WARENGINE_SA_PASSWORD=

# ─── Asistente IA y servidor MCP ──────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=
MCP_SERVER_URL=
MCP_HOST=
MCP_PORT=
