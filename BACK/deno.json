{
  "workspace": {
    "members": [
      "apps/api",
      "apps/mcp-server",
      "packages/shared-kernel",
      "packages/core",
      "packages/database",
      "packages/platform",
      "packages/composition"
    ]
  },
  "imports": {
    "@warengine/shared-kernel": "./packages/shared-kernel/mod.ts",
    "@warengine/core": "./packages/core/mod.ts",
    "@warengine/database": "./packages/database/mod.ts",
    "@warengine/platform": "./packages/platform/mod.ts",
    "@warengine/composition": "./packages/composition/mod.ts",
    "@warengine/contracts": "../SHARED/contracts/src/index.ts",
    "zod": "npm:zod@^3.24.0",
    "drizzle-orm": "npm:drizzle-orm@^0.38.4",
    "drizzle-kit": "npm:drizzle-kit@^0.30.5"
  },
  "tasks": {
    "dev-api": "deno run --allow-net --allow-env --allow-read apps/api/src/main.ts",
    "dev-mcp": "deno run --allow-net --allow-env --allow-read apps/mcp-server/src/main.ts",
    "test": "deno test --allow-all",
    "lint": "deno lint",
    "check": "deno check apps/api/src/main.ts apps/mcp-server/src/main.ts"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100
  }
}
